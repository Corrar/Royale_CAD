{
  "name": "royale-cad",
  "version": "0.1.0",
  "private": true,
  "description": "Royale CAD: 2D CAD for desktop, worked as AutoCAD is",
  "author": "Royale",
  "packageManager": "pnpm@12.5.1",
  "type": "module",
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron .",
    "check": "tsc -b && vitest run",
    "bench": "electron-vite build && electron . --bench",
    "bench:g2": "electron-vite build && electron . --bench --gate=g2",
    "smoke": "electron-vite build && electron . --smoke",
    "dist": "electron-vite build && electron-builder --win nsis --x64",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
